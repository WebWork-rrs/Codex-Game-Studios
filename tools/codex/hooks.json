{
  "description": "Codex game studio session context, commit/push checks, and asset validation.",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex/studio.py\" hook SessionStart", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "^(Bash|PowerShell|exec_command|shell_command|shell)$", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex/studio.py\" hook PreToolUse", "timeout": 45}]}],
    "PostToolUse": [{"matcher": "^(Write|Edit|apply_patch|Bash|PowerShell|exec_command|shell_command|shell)$", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex/studio.py\" hook PostToolUse", "timeout": 60}]}]
  }
}
